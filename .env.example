# Copy to .env (repo root) and fill in. Never commit .env. Everything is optional: with nothing set the app
# still works end to end (template scripts, free photo motion, no YouTube).

# --- AI (Gemini API key from aistudio.google.com; the project needs billing for video)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash        # scripts, titles, photo reading, sales reasons
VEO_MODEL=gemini-omni-1.2-flash           # image-to-video ("AI motion"); list yours: make models
VEO_COST_PER_SEC_CENTS=8                  # estimate used by the budget guard (8s ≈ $0.64)

# --- Google sign-in + YouTube (one Google Cloud OAuth "Web application" client; see docs/DEPLOY.md step 2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/youtube/auth/callback

# --- Security (make secrets)
APP_SECRET=          # Fernet key: encrypts sign-in sessions, YouTube connections, OAuth state. Required in production
OWNER_TOKEN=         # only used when DEMO_MODE=1
ADMIN_TOKEN=         # needed to change budget settings (PATCH /settings, header X-Admin-Token); empty = locked

# --- Modes
DEMO_MODE=0          # 0 = anyone with the URL can make videos (the budget cap protects spend)
MOCK_PIPELINE=0      # 1 = fake the pipeline with realistic timings (frontend work without ffmpeg/AI)
MOCK_FAIL_RATE=0     # e.g. 0.1 with MOCK_PIPELINE=1 to exercise failure UI

# --- Web
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
# DATA_DIR=backend/data   (default)
DATABASE_URL=        # Postgres (e.g. Neon pooled address) so branding, budget and history survive restarts; empty = SQLite
DATABASE_URL_UNPOOLED=  # Neon direct address, used only to create tables at startup (`neon env pull` writes both)

# MEDIA_DB_CAP_MB=300     rendered videos/posters/AI clips kept in the DB (clips, then posted videos, cleared first)

# --- Low-CPU hosts (e.g. Render free)
# RENDER_PRESET=ultrafast  KB_OVERSAMPLE=1  FFMPEG_THREADS=2 (default)  FFMPEG_TIMEOUT_S=600  SEED_RENDER=0  VEO_TIMEOUT_S=300

# --- Fair use (per visitor IP unless noted; defaults shown)
# JOBS_PER_HOUR_PER_IP=6  ACTIVE_JOBS_PER_IP=1  MAX_QUEUED_JOBS=4 (everyone)  UPLOADS_PER_HOUR_PER_IP=40  PHOTO_MAX_PX=1600
# SIGNINS_PER_HOUR_PER_IP=30
# DIRECTOR_PLANS_PER_HOUR_PER_IP=60  DIRECTOR_PLANS_PER_DAY=3000 (everyone)
# DIRECTOR_PREVIEWS_PER_HOUR_PER_IP=10  DIRECTOR_PREVIEWS_PER_DAY=40 (everyone, ~4¢ each)
# MASCOT_BATCHES_PER_HOUR_PER_IP=4  MASCOT_BATCHES_PER_DAY=15 (everyone, ~15¢ per batch of 4)
# DIRECTOR_IMAGE_MODEL=gemini-3.1-flash-image   (preview frames + mascots)

# --- Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
