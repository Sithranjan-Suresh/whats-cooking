# Copy to .env (repo root) and fill in. Never commit .env.

# --- AI (one key for Gemini Flash + Veo; put Veo on a PREPAID, auto-reload-OFF billing account)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash        # verify: python scripts/check_models.py
VEO_MODEL=veo-3.1-fast-generate-preview   # verify: python scripts/check_models.py
VEO_COST_PER_SEC_CENTS=8                  # from the current pricing page for that model at 720p

# --- YouTube (Google Cloud OAuth "Web application" client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/youtube/auth/callback

# --- Security (python scripts/gen_secrets.py)
APP_SECRET=
OWNER_TOKEN=

# --- Modes
DEMO_MODE=0          # 0 = anyone with the URL can make videos (cap protects spend); 1 = read-only demo unless OWNER_TOKEN
MOCK_PIPELINE=0      # 1 = fake the pipeline with realistic timings (frontend dev)
DEMO_CACHE=1         # Veo job for the seeded biryani replays seed/hero_veo_short.mp4
MOCK_FAIL_RATE=0     # e.g. 0.1 with MOCK_PIPELINE=1 to exercise failure UI

# --- Web
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
# DATA_DIR=backend/data   (default)

# --- Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
